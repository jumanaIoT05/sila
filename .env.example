# ── Database (PostgreSQL) ─────────────────────────────────────────
# Update user/password/host/db to match your local Postgres install.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sela?schema=public"

# ── Auth ──────────────────────────────────────────────────────────
# Secret used to sign JWT session tokens. Use a long random string.
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Mock OTP for local/dev. verify-otp accepts this fixed code.
# In dev the requested OTP is also logged to the server console.
MOCK_OTP_CODE="123456"

# ── AI Layer ──────────────────────────────────────────────────────
# "mock" (default) uses the deterministic MockAIProvider.
# "openai" uses OpenAIProvider (requires OPENAI_API_KEY).
AI_PROVIDER="mock"
OPENAI_API_KEY=""
