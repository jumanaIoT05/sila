# ── Database (PostgreSQL) ─────────────────────────────────────────
# Update user/password/host/db to match your local Postgres install.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sela?schema=public"

# ── Auth ──────────────────────────────────────────────────────────
# Secret used to sign JWT session tokens. Use a long random string.
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Mock OTP for local/dev. verify-otp accepts this fixed code.
# In dev the requested OTP is also logged to the server console.
MOCK_OTP_CODE="123456"

# ── AI Layer ──────────────────────────────────────────────────────
# Active provider: "mock" (default, offline) | "gemini" | "openai".
# The AI provider ONLY writes natural-language insights/recommendations/tips.
# It never computes financial values — the app stays the source of truth.
AI_PROVIDER="mock"

# OpenAI (stub, optional)
OPENAI_API_KEY=""

# Google Gemini (implemented in AI Phase B). Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
